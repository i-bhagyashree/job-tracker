{
  "installCommand": "npm install && npm install --prefix server --omit=dev && npm install --prefix client",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": { "api/index.js": { "includeFiles": "server/src/**" } },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
